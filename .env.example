# MRTorneio — copie para .env (projeto Supabase NOVO, dedicado)
# Nunca commitar .env com valores reais.

# URL do projeto (somente host, sem /rest/v1)
VITE_SUPABASE_URL=https://SEU_REF.supabase.co

# Chave anon / publishable (Settings → API)
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_anon_public

# Opcional (alias aceito pelo código):
# VITE_SUPABASE_ANON_KEY=

VITE_SUPABASE_PROJECT_ID=SEU_REF
